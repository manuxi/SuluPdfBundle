<?xml version="1.0" ?>
<form xmlns="http://schemas.sulu.io/template/template"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/form-1.0.xsd"
>
    <key>sulu_pdf_excerpt_pages</key>

    <!-- merged into the excerpt tab of pages (Sulu's own hook for extra excerpt fields); the values land in excerptData -->
    <tag name="sulu_content.content_excerpt_form" instanceOf="Sulu\Page\Domain\Model\PageDimensionContentInterface" priority="10"/>

    <properties>
        <section name="sulu_pdf">
            <meta>
                <title>sulu_pdf.excerpt.section</title>
            </meta>
            <properties>
                <property name="excerpt/pdf_enabled" type="checkbox" colspan="12">
                    <meta>
                        <title>sulu_pdf.excerpt.enabled.title</title>
                        <info_text>sulu_pdf.excerpt.enabled.info</info_text>
                    </meta>
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="default_value" value="false"/>
                    </params>
                </property>

                <property name="excerpt/pdf_show_captions" type="checkbox" colspan="4" visibleCondition="excerpt.pdf_enabled == true">
                    <meta>
                        <title>sulu_pdf.excerpt.show_captions.title</title>
                        <info_text>sulu_pdf.excerpt.show_captions.info</info_text>
                    </meta>
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="default_value" value="true"/>
                    </params>
                </property>

                <property name="excerpt/pdf_show_modified" type="checkbox" colspan="4" visibleCondition="excerpt.pdf_enabled == true">
                    <meta>
                        <title>sulu_pdf.excerpt.show_modified.title</title>
                        <info_text>sulu_pdf.excerpt.show_modified.info</info_text>
                    </meta>
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="default_value" value="true"/>
                    </params>
                </property>

                <property name="excerpt/pdf_show_online_link" type="checkbox" colspan="4" visibleCondition="excerpt.pdf_enabled == true">
                    <meta>
                        <title>sulu_pdf.excerpt.show_online_link.title</title>
                        <info_text>sulu_pdf.excerpt.show_online_link.info</info_text>
                    </meta>
                    <params>
                        <param name="type" value="toggler"/>
                        <param name="default_value" value="true"/>
                    </params>
                </property>

                <property name="excerpt/pdf_company_data" type="single_select" colspan="6" visibleCondition="excerpt.pdf_enabled == true">
                    <meta>
                        <title>sulu_pdf.excerpt.company_data.title</title>
                        <info_text>sulu_pdf.excerpt.company_data.info</info_text>
                    </meta>
                    <params>
                        <param name="default_value" value="none"/>
                        <param name="values" type="collection">
                            <param name="none">
                                <meta>
                                    <title>sulu_pdf.excerpt.company_data.none</title>
                                </meta>
                            </param>
                            <param name="footer">
                                <meta>
                                    <title>sulu_pdf.excerpt.company_data.footer</title>
                                </meta>
                            </param>
                            <param name="end">
                                <meta>
                                    <title>sulu_pdf.excerpt.company_data.end</title>
                                </meta>
                            </param>
                        </param>
                    </params>
                </property>
            </properties>
        </section>
    </properties>
</form>
