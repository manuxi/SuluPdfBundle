{
    "name": "manuxi/sulu-pdf-bundle",
    "type": "symfony-bundle",
    "description": "PDF download for Sulu content: renders the public page of an article, event or page and sets its content into a designed PDF layout",
    "license": "MIT",
    "keywords": [
        "sulu",
        "suluCms",
        "pdf",
        "dompdf",
        "download"
    ],
    "authors": [
        {
            "name": "Manuel Bertrams",
            "email": "manu@bytefresser.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-intl": "*",
        "bacon/bacon-qr-code": "^3.0",
        "dompdf/dompdf": "^3.1",
        "doctrine/dbal": "^3.6 || ^4.0",
        "sulu/sulu": "^3.0",
        "symfony/css-selector": "^6.4 || ^7.0",
        "symfony/framework-bundle": "^6.4 || ^7.0",
        "symfony/string": "^6.4 || ^7.0",
        "symfony/twig-bundle": "^6.4 || ^7.0"
    },
    "suggest": {
        "manuxi/sulu-article-configuration-bundle": "Per-article switches for the PDF (captions, author box, online link, company data)"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5"
    },
    "autoload": {
        "psr-4": {
            "Manuxi\\SuluPdfBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Manuxi\\SuluPdfBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@phpunit"
        ],
        "phpunit": "vendor/bin/phpunit"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true
        }
    }
}
